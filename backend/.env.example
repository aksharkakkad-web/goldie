GOLDIE_BACKEND_HOST=127.0.0.1
GOLDIE_BACKEND_PORT=8787
GOLDIE_ALLOWED_ORIGIN=http://127.0.0.1:3000
GOLDIE_PROVIDER_TIMEOUT_MS=5000
# Server-only. Private handoff context is opt-in; never include secrets.
# Google's unpaid API data-use terms apply. No automatic tier/model upgrades.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOLDIE_GEMINI_TIMEOUT_MS=20000
# Local speech input only; install explicitly using docs/stage3-integration.md.
# Absolute paths to whisper.cpp v1.9.5, base.en and FFmpeg. No runtime downloads.
GOLDIE_WHISPER_BIN=
GOLDIE_WHISPER_MODEL_PATH=
GOLDIE_FFMPEG_BIN=
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
GOLDIE_SPEECH_TIMEOUT_MS=20000
# Optional absolute path; defaults to backend/.data (ignored by Git).
# GOLDIE_DATA_DIR=
